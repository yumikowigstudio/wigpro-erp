rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && userData().role == 'super_admin';
    }

    function belongsToCompany(companyId) {
      return isAuthenticated()
        && companyId is string
        && companyId != ''
        && (isSuperAdmin() || userData().companyId == companyId);
    }

    function metadataCompanyMatches(companyId) {
      return request.resource.metadata.companyId == companyId;
    }

    function resourceCompanyMatches() {
      return resource.metadata.companyId is string && belongsToCompany(resource.metadata.companyId);
    }

    function isValidImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif'
        ];
    }

    function isValidDocument() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        ];
    }

    function customerCompanyId(customerId) {
      return firestore.get(/databases/(default)/documents/customers/$(customerId)).data.companyId;
    }

    function productCompanyId(productId) {
      return firestore.get(/databases/(default)/documents/products/$(productId)).data.companyId;
    }

    function workOrderCompanyId(orderId) {
      return firestore.get(/databases/(default)/documents/work_orders/$(orderId)).data.companyId;
    }

    function documentCompanyId(docId) {
      return firestore.get(/databases/(default)/documents/documents/$(docId)).data.companyId;
    }

    match /companies/{companyId}/{allPaths=**} {
      allow read: if belongsToCompany(companyId);
      allow create, update: if belongsToCompany(companyId)
        && metadataCompanyMatches(companyId)
        && (isValidImage() || isValidDocument());
      allow delete: if belongsToCompany(companyId);
    }

    match /customers/{customerId}/{allPaths=**} {
      allow read: if belongsToCompany(customerCompanyId(customerId));
      allow create, update: if belongsToCompany(customerCompanyId(customerId))
        && metadataCompanyMatches(customerCompanyId(customerId))
        && isValidImage();
      allow delete: if belongsToCompany(customerCompanyId(customerId));
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if belongsToCompany(productCompanyId(productId));
      allow create, update: if belongsToCompany(productCompanyId(productId))
        && metadataCompanyMatches(productCompanyId(productId))
        && isValidImage();
      allow delete: if belongsToCompany(productCompanyId(productId));
    }

    match /work_orders/{orderId}/{allPaths=**} {
      allow read: if belongsToCompany(workOrderCompanyId(orderId));
      allow create, update: if belongsToCompany(workOrderCompanyId(orderId))
        && metadataCompanyMatches(workOrderCompanyId(orderId))
        && isValidImage();
      allow delete: if belongsToCompany(workOrderCompanyId(orderId));
    }

    match /documents/{docId}/{allPaths=**} {
      allow read: if belongsToCompany(documentCompanyId(docId));
      allow create, update: if belongsToCompany(documentCompanyId(docId))
        && metadataCompanyMatches(documentCompanyId(docId))
        && (isValidImage() || isValidDocument());
      allow delete: if belongsToCompany(documentCompanyId(docId));
    }

    match /payment_slips/{slipId} {
      allow read: if resourceCompanyMatches();
      allow create, update: if metadataCompanyMatches(request.resource.metadata.companyId) && belongsToCompany(request.resource.metadata.companyId) && isValidImage();
      allow delete: if resourceCompanyMatches();
    }

    match /company/{companyId}/{allPaths=**} {
      allow read: if belongsToCompany(companyId);
      allow create, update: if belongsToCompany(companyId)
        && metadataCompanyMatches(companyId)
        && isValidImage();
      allow delete: if belongsToCompany(companyId);
    }
  }
}
