rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isAuthenticated() && getUserData().role in roles;
    }

    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    function isOwner() {
      return hasRole(['super_admin', 'owner']);
    }

    function isBranchManager() {
      return hasRole(['super_admin', 'owner', 'branch_manager']);
    }

    function isStaff() {
      return hasRole(['super_admin', 'owner', 'branch_manager', 'sales', 'stylist', 'staff', 'accountant']);
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && getUserData().companyId == companyId;
    }

    // Companies — super_admin (เจ้าของระบบ) เห็น/จัดการทุกร้านได้
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || belongsToCompany(companyId);
      allow write: if isSuperAdmin();
    }

    // Branches — super_admin ข้ามร้านได้
    match /branches/{branchId} {
      allow read: if isSuperAdmin() || (isStaff() && belongsToCompany(resource.data.companyId));
      allow write: if isOwner();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isBranchManager());
      // สร้างผู้ใช้: super_admin ทำได้ทุกอย่าง · owner สร้างได้แต่ห้ามตั้งเป็น super_admin
      // · founder (อีเมลเจ้าของระบบ) สร้างโปรไฟล์ super_admin ตัวเองได้ครั้งแรก (bootstrap)
      allow create: if isSuperAdmin()
                    || (isOwner() && request.resource.data.role != 'super_admin')
                    || (isAuthenticated() && request.auth.uid == userId
                        && request.auth.token.email == 'yumikosystem@gmail.com')
                    || (isAuthenticated() && request.auth.uid == userId
                        && request.resource.data.role != 'super_admin');
      // แก้ไข: super_admin ทำได้ทุกอย่าง · owner/manager จัดการผู้ใช้ในบริษัทเดียวกันได้
      // แต่ห้ามแตะ role super_admin (ทั้งตั้งขึ้นและแก้ของที่เป็นอยู่) — กันยกระดับเป็นเจ้าของระบบ
      // · ตัวเองแก้ได้แต่ห้ามเปลี่ยน role/companyId
      allow update: if isSuperAdmin()
                    || (isBranchManager()
                        && request.resource.data.companyId == resource.data.companyId
                        && request.resource.data.role != 'super_admin'
                        && resource.data.role != 'super_admin')
                    || (isAuthenticated() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.companyId == resource.data.companyId);
      allow delete: if isSuperAdmin() || (isOwner() && resource.data.role != 'super_admin');
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isStaff() && belongsToCompany(resource.data.companyId);
      allow write: if isBranchManager();
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isStaff() && belongsToCompany(resource.data.companyId);
      allow delete: if isBranchManager();
    }

    match /customer_images/{imageId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /customer_documents/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /customer_timeline/{timelineId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isBranchManager();
    }

    // Service records (บันทึกผลบริการ + คำแนะนำ)
    match /service_records/{recordId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isStaff() && belongsToCompany(resource.data.companyId);
      allow delete: if isBranchManager();
    }

    // Products & Services
    match /products/{productId} {
      allow read: if isStaff();
      allow write: if isBranchManager();
    }

    match /services/{serviceId} {
      allow read: if isStaff();
      allow write: if isBranchManager();
    }

    // Inventory
    match /inventory/{inventoryId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /transfer_orders/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isBranchManager();
      allow delete: if isOwner();
    }

    match /stock_movements/{movementId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable
    }

    // Work Orders (Production)
    match /work_orders/{orderId} {
      allow read: if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isStaff() && belongsToCompany(resource.data.companyId);
      allow delete: if isBranchManager();
    }

    // Sales & POS
    match /sales/{saleId} {
      allow read: if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isBranchManager();
      allow delete: if isOwner();
    }

    match /deposits/{depositId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Returns / exchanges (คืน-เปลี่ยนสินค้า)
    match /returns/{returnId} {
      allow read:   if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isBranchManager();
      allow delete: if isOwner();
    }

    // Coupons (คูปองส่วนลด)
    match /coupons/{couponId} {
      allow read:   if isStaff();
      allow write:  if isBranchManager();
    }

    // Accounting
    match /expenses/{expenseId} {
      allow read: if hasRole(['super_admin', 'owner', 'branch_manager', 'accountant']);
      allow create: if isStaff();
      allow update: if isBranchManager();
      allow delete: if isOwner();
    }

    // Commission
    match /commission_records/{recordId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isBranchManager();
      allow delete: if isOwner();
    }

    // Documents
    match /documents/{docId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Quotations (ใบเสนอราคา)
    match /quotations/{quotationId} {
      allow read:   if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isStaff() && belongsToCompany(resource.data.companyId);
      allow delete: if isBranchManager();
    }

    // Notifications — เป็นแบบทั้งร้าน (query ใช้ companyId) ไม่ใช่รายบุคคล
    // staff ในบริษัทเดียวกันอ่าน/อัพเดท/ลบได้ ตรงกับการใช้งานจริงในแอป
    match /notifications/{notificationId} {
      allow read:   if isStaff() && belongsToCompany(resource.data.companyId);
      allow create: if isStaff();
      allow update: if isStaff() && belongsToCompany(resource.data.companyId);
      allow delete: if isStaff() && belongsToCompany(resource.data.companyId);
    }

    // Logs - append only
    match /activity_logs/{logId} {
      allow read: if isOwner();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable
    }

    // Settings
    match /system_settings/{settingId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /membership_config/{configId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /point_transactions/{txId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    match /discount_requests/{requestId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isBranchManager();
      allow delete: if isOwner();
    }
  }
}
