rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userCompanyId() {
      return getUserData().companyId;
    }

    function userIsActive() {
      return hasUserProfile() && getUserData().isActive != false;
    }

    function hasRole(roles) {
      return isAuthenticated() && userIsActive() && getUserData().role in roles;
    }

    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    function isOwner() {
      return hasRole(['super_admin', 'owner']);
    }

    function isBranchManager() {
      return hasRole(['super_admin', 'owner', 'branch_manager']);
    }

    function isStaff() {
      return hasRole(['super_admin', 'owner', 'branch_manager', 'sales', 'stylist', 'staff', 'accountant']);
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && userIsActive() && companyId is string && companyId != '' && userCompanyId() == companyId;
    }

    function hasCompanyId(data) {
      return data.companyId is string && data.companyId != '';
    }

    function canReadCompanyData() {
      return isSuperAdmin() || (hasCompanyId(resource.data) && belongsToCompany(resource.data.companyId));
    }

    function canCreateCompanyData() {
      return isSuperAdmin() || (hasCompanyId(request.resource.data) && belongsToCompany(request.resource.data.companyId));
    }

    function canUpdateCompanyData() {
      return isSuperAdmin()
        || (hasCompanyId(resource.data)
          && hasCompanyId(request.resource.data)
          && belongsToCompany(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId);
    }

    function canDeleteCompanyData() {
      return isSuperAdmin() || (hasCompanyId(resource.data) && belongsToCompany(resource.data.companyId));
    }

    function canCreateOwnPermissionRequest() {
      return isAuthenticated()
        && userIsActive()
        && hasCompanyId(request.resource.data)
        && belongsToCompany(request.resource.data.companyId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.permission is string
        && request.resource.data.path is string;
    }

    function canReadCompanyDoc(companyId) {
      return isSuperAdmin() || belongsToCompany(companyId);
    }

    function canReadSetting(settingId) {
      return isSuperAdmin() || (isStaff() && (settingId == userCompanyId() || settingId == userCompanyId() + '_tax'));
    }

    function canWriteSetting(settingId) {
      return isSuperAdmin() || (isOwner() && (settingId == userCompanyId() || settingId == userCompanyId() + '_tax'));
    }

    function assignableUserRole(role) {
      return role in ['branch_manager', 'sales', 'stylist', 'staff', 'accountant'];
    }

    function canOwnerManageUser() {
      return isOwner()
        && canUpdateCompanyData()
        && assignableUserRole(resource.data.role)
        && assignableUserRole(request.resource.data.role)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.email == resource.data.email
        && request.resource.data.isActive is bool
        && request.resource.data.permissions is list
        && request.resource.data.branchId is string
        && request.resource.data.branchId != '';
    }

    match /companies/{companyId} {
      allow read: if canReadCompanyDoc(companyId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isOwner() && canCreateCompanyData();
      allow update: if isOwner() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /users/{userId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && request.auth.uid == userId)
        || (isBranchManager() && canReadCompanyData());
      allow create: if isSuperAdmin()
        || (isOwner()
          && canCreateCompanyData()
          && request.resource.data.role in ['branch_manager', 'sales', 'stylist', 'staff', 'accountant']
          && request.resource.data.branchId is string
          && request.resource.data.branchId != ''
          && request.resource.data.isActive == true)
        || (isAuthenticated()
          && request.auth.uid == userId
          && request.auth.token.email == 'yumikosystem@gmail.com'
          && request.resource.data.role == 'super_admin'
          && request.resource.data.companyId == '');
      allow update: if isSuperAdmin()
        || canOwnerManageUser()
        || (isAuthenticated()
          && request.auth.uid == userId
          && canUpdateCompanyData()
          && request.resource.data.role == resource.data.role
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.permissions == resource.data.permissions);
      allow delete: if isSuperAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isBranchManager() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /customers/{customerId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /customer_work_cases/{caseId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isStaff() && canDeleteCompanyData();
    }

    match /customer_images/{imageId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isStaff() && canDeleteCompanyData();
    }

    match /customer_documents/{docId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isStaff() && canDeleteCompanyData();
    }

    match /customer_timeline/{timelineId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /service_records/{recordId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isStaff() && canDeleteCompanyData();
    }

    match /appointments/{appointmentId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /products/{productId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isBranchManager() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /product_categories/{categoryId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isBranchManager() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /service_categories/{categoryId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isBranchManager() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /services/{serviceId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isBranchManager() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /inventory/{inventoryId} {
      allow read: if isStaff() && canReadCompanyData();
      allow get: if isStaff() && !exists(/databases/$(database)/documents/inventory/$(inventoryId));
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /transfer_orders/{orderId} {
      allow read: if isStaff() && canReadCompanyData();
      allow get: if isStaff() && !exists(/databases/$(database)/documents/transfer_orders/$(orderId));
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /stock_movements/{movementId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update, delete: if false;
    }

    match /work_orders/{orderId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /production_orders/{orderId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /sales/{saleId} {
      allow read: if isStaff() && canReadCompanyData();
      allow get: if isStaff() && !exists(/databases/$(database)/documents/sales/$(saleId));
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /deposits/{depositId} {
      allow read: if isStaff() && canReadCompanyData();
      allow get: if isStaff() && !exists(/databases/$(database)/documents/deposits/$(depositId));
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /returns/{returnId} {
      allow read: if isStaff() && canReadCompanyData();
      allow get: if isStaff() && !exists(/databases/$(database)/documents/returns/$(returnId));
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /return_totals/{saleId} {
      allow get: if isStaff() && (canReadCompanyData() || !exists(/databases/$(database)/documents/return_totals/$(saleId)));
      allow list: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if false;
    }

    match /coupons/{couponId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isBranchManager() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /expenses/{expenseId} {
      allow read: if hasRole(['super_admin', 'owner', 'branch_manager', 'accountant']) && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /commission_records/{recordId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /documents/{docId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isStaff() && canDeleteCompanyData();
    }

    match /quotations/{quotationId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isBranchManager() && canDeleteCompanyData();
    }

    match /notifications/{notificationId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isStaff() && canUpdateCompanyData();
      allow delete: if isStaff() && canDeleteCompanyData();
    }

    match /activity_logs/{logId} {
      allow read: if isOwner() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwner() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update, delete: if false;
    }

    match /permission_requests/{requestId} {
      allow read: if isOwner() && canReadCompanyData();
      allow create: if canCreateOwnPermissionRequest();
      allow update: if isOwner()
        && canUpdateCompanyData()
        && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /document_counters/{counterId} {
      allow get: if isStaff()
        && (canReadCompanyData()
          || !exists(/databases/$(database)/documents/document_counters/$(counterId)));
      allow list: if isStaff() && canReadCompanyData();
      allow create, update: if isStaff()
        && canCreateCompanyData()
        && request.resource.data.branchId is string
        && request.resource.data.branchId != ''
        && request.resource.data.type is string
        && request.resource.data.yearMonth is string
        && request.resource.data.seq is number;
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /system_settings/{settingId} {
      allow read: if canReadSetting(settingId);
      allow create, update, delete: if canWriteSetting(settingId);
    }

    match /membership_config/{configId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isOwner() && canCreateCompanyData();
      allow update: if isOwner() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /point_transactions/{txId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isOwner() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }

    match /discount_requests/{requestId} {
      allow read: if isStaff() && canReadCompanyData();
      allow create: if isStaff() && canCreateCompanyData();
      allow update: if isBranchManager() && canUpdateCompanyData();
      allow delete: if isOwner() && canDeleteCompanyData();
    }
  }
}
